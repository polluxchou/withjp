# Supabase — get these from your project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Optional: route Gemini requests through a relay/proxy when Google APIs
# are blocked from the server environment.
# GEMINI_BASE_URL=https://your-proxy-endpoint.com

# DeepSeek API key — https://platform.deepseek.com/api_keys
# Used by venue name translation and, by default, by the intent parser's
# fast tier (classification + query extraction).
DEEPSEEK_API_KEY=sk-...

# Optional: OpenAI-compatible base URL for DeepSeek (self-hosted relay).
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Intent parser's fast tier: deepseek (default) | gemini
# Set to `gemini` to fall classification and query extraction back to
# gemini-2.5-flash. The strong tier (write extraction, work tasks, and the
# retry after a fast-tier parse failure) is always gemini-2.5-pro.
# Changing this needs a redeploy — the value is read at module load.
# INTENT_FAST_PROVIDER=deepseek
